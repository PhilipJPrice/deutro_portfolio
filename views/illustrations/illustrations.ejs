<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Illustrations — Deutro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .project-page {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 48px 32px 96px;
        }

        /* ── Breadcrumb ── */
        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 36px;
            font-size: 13px;
            color: var(--text-muted);
        }
        .breadcrumb a {
            color: var(--gold);
            text-decoration: none;
            font-weight: 600;
            transition: opacity 0.2s;
        }
        .breadcrumb a:hover { opacity: 0.7; }
        .breadcrumb-sep { color: var(--gold-border); }

        /* ── Header ── */
        .project-eyebrow {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--gold);
            opacity: 0.75;
            margin: 0 0 12px;
        }
        .project-title {
            font-size: clamp(32px, 5vw, 52px);
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 12px;
            line-height: 1.1;
            letter-spacing: -0.02em;
        }
        .project-title span {
            color: var(--gold);
            text-shadow: 0 0 28px rgba(204,170,75,0.4);
        }
        .project-desc {
            font-size: 16px;
            line-height: 1.75;
            color: var(--text-muted);
            max-width: 680px;
            margin: 0;
        }

        /* ── Gold rule ── */
        .gold-rule {
            width: 100%;
            height: 1px;
            background: linear-gradient(90deg, var(--gold) 0%, rgba(204,170,75,0.3) 60%, transparent 100%);
            box-shadow: 0 0 8px rgba(204,170,75,0.2);
            margin: 28px 0 36px;
        }

        /* ── Count badge ── */
        .poster-count {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 28px;
        }
        .poster-count-num {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            border: 1.5px solid var(--gold);
            color: var(--gold);
            font-size: 12px;
            font-weight: 700;
        }

        /* ── Masonry grid ── */
        .poster-grid {
            columns: 4;
            column-gap: 16px;
        }

        .poster-item {
            break-inside: avoid;
            margin-bottom: 16px;
            position: relative;
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid var(--gold-border);
            background: var(--card-bg);
            box-shadow: 0 6px 24px rgba(0,0,0,0.4);
            cursor: pointer;
            transition: border-color 0.35s ease, box-shadow 0.35s ease;
        }
        .poster-item:hover {
            border-color: rgba(204,170,75,0.55);
            box-shadow: 0 0 22px rgba(204,170,75,0.22), 0 10px 32px rgba(0,0,0,0.55);
        }
        .poster-item img {
            display: block;
            width: 100%;
            height: auto;
            transition: transform 0.45s ease, filter 0.35s ease;
        }
        .poster-item:hover img {
            transform: scale(1.03);
            filter: brightness(1.1);
        }

        /* Name overlay on hover */
        .poster-overlay {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            padding: 32px 12px 12px;
            background: linear-gradient(transparent, rgba(11,12,16,0.9));
            opacity: 0;
            transition: opacity 0.3s ease;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 6px;
        }
        .poster-item:hover .poster-overlay { opacity: 1; }
        .poster-name {
            font-size: 12px;
            font-weight: 700;
            color: var(--gold);
            letter-spacing: 0.04em;
            line-height: 1.3;
        }
        .poster-num {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            white-space: nowrap;
            flex-shrink: 0;
        }

        /* ── Lightbox ── */
        .lightbox {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 1000;
            background: rgba(5,6,9,0.95);
            backdrop-filter: blur(14px);
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .lightbox.open { display: flex; }

        .lightbox-inner {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 14px;
            max-width: 90vw;
            max-height: 92vh;
        }

        .lightbox-frame {
            border-radius: 14px;
            padding: 3px;
            background: linear-gradient(135deg,
                rgba(204,170,75,0.9) 0%,
                rgba(204,170,75,0.25) 35%,
                rgba(204,170,75,0.1) 50%,
                rgba(204,170,75,0.25) 65%,
                rgba(204,170,75,0.9) 100%
            );
            box-shadow:
                0 0 60px rgba(204,170,75,0.14),
                0 24px 64px rgba(0,0,0,0.85);
        }
        .lightbox-frame img {
            display: block;
            max-width: 82vw;
            max-height: 80vh;
            border-radius: 12px;
            object-fit: contain;
        }

        .lightbox-caption {
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .lightbox-title {
            font-size: 15px;
            font-weight: 700;
            color: var(--gold);
            letter-spacing: 0.04em;
        }
        .lightbox-index {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* Close button */
        .lightbox-close {
            position: fixed;
            top: 18px;
            right: 22px;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 1.5px solid var(--gold-border);
            background: rgba(19,20,26,0.92);
            color: var(--gold);
            font-size: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            line-height: 1;
            transition: border-color 0.2s, background 0.2s;
            z-index: 1001;
        }
        .lightbox-close:hover {
            border-color: var(--gold);
            background: rgba(204,170,75,0.12);
        }

        /* Prev / Next arrows */
        .lightbox-nav {
            position: fixed;
            top: 50%;
            transform: translateY(-50%);
            width: 46px;
            height: 46px;
            border-radius: 50%;
            border: 1.5px solid var(--gold-border);
            background: rgba(19,20,26,0.88);
            color: var(--gold);
            font-size: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            user-select: none;
            transition: border-color 0.2s, background 0.2s;
            z-index: 1001;
        }
        .lightbox-nav:hover {
            border-color: var(--gold);
            background: rgba(204,170,75,0.12);
        }
        .lightbox-prev { left: 14px; }
        .lightbox-next { right: 14px; }

        /* ── Responsive ── */
        @media (max-width: 1024px) { .poster-grid { columns: 3; } }
        @media (max-width: 680px)  { .poster-grid { columns: 2; column-gap: 10px; } .poster-item { margin-bottom: 10px; } }
        @media (max-width: 400px)  {
            .poster-grid { columns: 1; }
            .project-page { padding: 28px 14px 56px; }
            .lightbox-frame img { max-width: 92vw; max-height: 75vh; }
        }
    </style>
</head>
<body>
