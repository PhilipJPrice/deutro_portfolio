                <img src="/img/Posters/24Starfield.png" alt="Starfield" loading="lazy">
                <div class="poster-overlay"><span class="poster-name">Starfield</span><span class="poster-num">24</span></div>
            </div>

            <div class="poster-item" data-index="24">
