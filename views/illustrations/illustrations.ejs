            <div class="poster-item" data-index="11">
                <img src="/img/Posters/12Four_Leaf_Clover.png" alt="Four Leaf Clover" loading="lazy">
                <div class="poster-overlay"><span class="poster-name">Four Leaf Clover</span><span class="poster-num">12</span></div>
            </div>

            <div class="poster-item" data-index="12">
                <img src="/img/Posters/13Fire.jpg" alt="Fire" loading="lazy">
