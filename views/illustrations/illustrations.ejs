            </div>

            <div class="poster-item" data-index="13">
                <img src="/img/Posters/14Wine.jpg" alt="Wine" loading="lazy">
                <div class="poster-overlay"><span class="poster-name">Wine</span><span class="poster-num">14</span></div>
            </div>

            <div class="poster-item" data-index="14">
                <img src="/img/Posters/15Cell_Phone_Tower.png" alt="Cell Phone Tower" loading="lazy">
                <div class="poster-overlay"><span class="poster-name">Cell Phone Tower</span><span class="poster-num">15</span></div>
            </div>

            <div class="poster-item" data-index="15">
                <img src="/img/Posters/16Lights_Camera_Action.png" alt="Lights Camera Action" loading="lazy">
                <div class="poster-overlay"><span class="poster-name">Lights Camera Action</span><span class="poster-num">16</span></div>
            </div>

            <div class="poster-item" data-index="16">
                <img src="/img/Posters/17Neon_Lightning.jpg" alt="Neon Lightning" loading="lazy">
