<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Illustrations 2025–2026 — Deutro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .project-page {
            width: 100%;
            max-width: 1100px;
            margin: 0 auto;
            padding: 48px 32px 96px;
        }

        /* ── Breadcrumb ── */
        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 36px;
            font-size: 13px;
            color: var(--text-muted);
        }
        .breadcrumb a {
            color: var(--gold);
            text-decoration: none;
            font-weight: 600;
            transition: opacity 0.2s;
        }
        .breadcrumb a:hover { opacity: 0.7; }
        .breadcrumb-sep { color: var(--gold-border); }

        /* ── Header ── */
        .project-eyebrow {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--gold);
            opacity: 0.75;
            margin: 0 0 12px;
        }
        .project-title {
            font-size: clamp(28px, 4.5vw, 48px);
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 12px;
            line-height: 1.1;
            letter-spacing: -0.02em;
        }
        .project-title span {
            color: var(--gold);
            text-shadow: 0 0 28px rgba(204,170,75,0.4);
        }
        .project-desc {
            font-size: 16px;
            line-height: 1.75;
            color: var(--text-muted);
            max-width: 680px;
            margin: 0;
        }

        /* ── Gold rule ── */
        .gold-rule {
            width: 100%;
            height: 1px;
            background: linear-gradient(90deg, var(--gold) 0%, rgba(204,170,75,0.3) 60%, transparent 100%);
            box-shadow: 0 0 8px rgba(204,170,75,0.2);
            margin: 28px 0 48px;
        }

        /* ════════════════════════════════
           GALLERY LAYOUT
           Row 1: Love (16:9, full-width)
           Row 2: Buddha (16:9) + Angel (1:1)
           Row 3: Deutro (16:9, full-width)
           Row 4: Gold (1:1) + Happiness (1:1)
        ════════════════════════════════ */

        .gallery {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* Shared image card */
        .img-card {
            position: relative;
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid var(--gold-border);
            background: var(--card-bg);
            box-shadow: 0 8px 32px rgba(0,0,0,0.5);
            cursor: pointer;
            transition: border-color 0.35s ease, box-shadow 0.35s ease;
        }
        .img-card:hover {
            border-color: rgba(204,170,75,0.55);
            box-shadow: 0 0 28px rgba(204,170,75,0.18), 0 12px 40px rgba(0,0,0,0.65);
        }
        .img-card img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease, filter 0.35s ease;
        }
        .img-card:hover img {
            transform: scale(1.03);
            filter: brightness(1.08);
        }

        /* Hover label overlay */
        .img-card-overlay {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            padding: 48px 18px 16px;
            background: linear-gradient(transparent, rgba(11,12,16,0.88));
            opacity: 0;
            transition: opacity 0.35s ease;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 8px;
        }
        .img-card:hover .img-card-overlay { opacity: 1; }

        .img-card-title {
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 700;
            color: var(--gold);
            letter-spacing: 0.05em;
            text-shadow: 0 1px 4px rgba(0,0,0,0.8);
        }
        .img-card-year {
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            white-space: nowrap;
        }

        /* ── Row containers ── */
        .row { display: flex; gap: 20px; }

        /* Row 1 — Love: full width, 16:9 */
        .card-love {
            aspect-ratio: 16 / 9;
            width: 100%;
        }

        /* Row 2 — Buddha (16:9) + Angel (1:1) side by side */
        .row-2 { align-items: stretch; }
        .card-buddha {
            flex: 2;
            aspect-ratio: 16 / 9;
        }
        .card-angel {
            flex: 1;
            aspect-ratio: 1 / 1;
        }

        /* Row 3 — Deutro: full width, 16:9 */
        .card-deutro {
            aspect-ratio: 16 / 9;
            width: 100%;
        }

        /* Row 4 — Gold + Happiness: two equal squares */
        .row-4 { align-items: stretch; }
        .card-gold,
        .card-happiness {
            flex: 1;
            aspect-ratio: 1 / 1;
        }

        /* ── Lightbox ── */
        .lightbox {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 1000;
            background: rgba(5,6,9,0.96);
            backdrop-filter: blur(16px);
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .lightbox.open { display: flex; }

        .lightbox-inner {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
            max-width: 92vw;
        }

        .lightbox-frame {
            border-radius: 14px;
            padding: 3px;
            background: linear-gradient(135deg,
                rgba(204,170,75,0.9) 0%,
                rgba(204,170,75,0.25) 35%,
                rgba(204,170,75,0.08) 50%,
                rgba(204,170,75,0.25) 65%,
                rgba(204,170,75,0.9) 100%
            );
            box-shadow: 0 0 60px rgba(204,170,75,0.14), 0 24px 64px rgba(0,0,0,0.9);
        }
        .lightbox-frame img {
            display: block;
            max-width: 88vw;
            max-height: 82vh;
            border-radius: 12px;
            object-fit: contain;
        }

        .lightbox-caption {
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .lightbox-title {
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            font-weight: 700;
            color: var(--gold);
            letter-spacing: 0.05em;
        }
        .lightbox-sub {
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            color: var(--text-muted);
        }

        .lightbox-close {
            position: fixed;
            top: 18px; right: 22px;
            width: 42px; height: 42px;
            border-radius: 50%;
            border: 1.5px solid var(--gold-border);
            background: rgba(19,20,26,0.92);
            color: var(--gold);
            font-size: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: border-color 0.2s, background 0.2s;
            z-index: 1001;
            line-height: 1;
        }
        .lightbox-close:hover {
            border-color: var(--gold);
            background: rgba(204,170,75,0.12);
        }

        .lightbox-nav {
            position: fixed;
            top: 50%;
            transform: translateY(-50%);
            width: 46px; height: 46px;
            border-radius: 50%;
            border: 1.5px solid var(--gold-border);
            background: rgba(19,20,26,0.88);
            color: var(--gold);
            font-size: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            user-select: none;
            transition: border-color 0.2s, background 0.2s;
            z-index: 1001;
        }
        .lightbox-nav:hover {
            border-color: var(--gold);
            background: rgba(204,170,75,0.12);
        }
        .lightbox-prev { left: 14px; }
        .lightbox-next { right: 14px; }

        /* ── Responsive ── */
        @media (max-width: 768px) {
            .row-2, .row-4 { flex-direction: column; }
            .card-buddha, .card-angel,
            .card-gold,   .card-happiness { flex: none; width: 100%; }
            .card-angel    { aspect-ratio: 1 / 1; }
            .card-happiness { aspect-ratio: 1 / 1; }
        }
        @media (max-width: 480px) {
            .project-page { padding: 28px 14px 60px; }
            .gallery { gap: 12px; }
            .row { gap: 12px; }
        }
    </style>
</head>
<body>
    <%- include('../partials/topbar') %>

    <div class="project-page">

        <!-- Breadcrumb -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="breadcrumb-sep">›</span>
            <a href="/#illustrations">Illustrations</a>
            <span class="breadcrumb-sep">›</span>
            <span>2025–2026</span>
        </nav>

        <!-- Header -->
        <header>
            <p class="project-eyebrow">3D Illustration · Blender · 2025–2026</p>
            <h1 class="project-title">Illustrations 2025–2026</h1>
            <p class="project-desc">
                A series of 3D-rendered illustrations exploring light, spirituality, identity, and emotion.
                Each piece is rendered in Blender — working with neon glow, volumetric light, reflective
                materials, and typographic form to build images that feel charged with meaning.
            </p>
            <div class="badge-row" style="margin-top:16px;">
                <span class="sw-badge badge-blender">Blender</span>
            </div>
        </header>

        <div class="gold-rule"></div>

        <!-- ── Gallery ── -->
        <div class="gallery">

            <!-- Row 1: Love — full width landscape -->
            <div class="img-card card-love" data-index="0">
                <img src="/img/Illustrations_2025-2026/Love.png" alt="Love">
                <div class="img-card-overlay">
                    <span class="img-card-title">Love</span>
                    <span class="img-card-year">2025–2026</span>
                </div>
            </div>

            <!-- Row 2: Buddha (landscape 2/3) + Angel (square 1/3) -->
            <div class="row row-2">
                <div class="img-card card-buddha" data-index="1">
                    <img src="/img/Illustrations_2025-2026/Buddha.png" alt="Buddha">
                    <div class="img-card-overlay">
                        <span class="img-card-title">Buddha</span>
                        <span class="img-card-year">2025–2026</span>
                    </div>
                </div>
                <div class="img-card card-angel" data-index="5">
                    <img src="/img/Illustrations_2025-2026/Angel.png" alt="Angel">
                    <div class="img-card-overlay">
                        <span class="img-card-title">Angel</span>
                        <span class="img-card-year">2025–2026</span>
                    </div>
                </div>
            </div>

            <!-- Row 3: Deutro — full width landscape -->
            <div class="img-card card-deutro" data-index="2">
                <img src="/img/Illustrations_2025-2026/Deutro.png" alt="Deutro">
                <div class="img-card-overlay">
                    <span class="img-card-title">Deutro</span>
                    <span class="img-card-year">2025–2026</span>
                </div>
            </div>

            <!-- Row 4: Gold + Happiness — two equal squares -->
            <div class="row row-4">
                <div class="img-card card-gold" data-index="4">
                    <img src="/img/Illustrations_2025-2026/Gold.png" alt="Gold">
                    <div class="img-card-overlay">
                        <span class="img-card-title">Gold</span>
                        <span class="img-card-year">2025–2026</span>
                    </div>
                </div>
                <div class="img-card card-happiness" data-index="3">
                    <img src="/img/Illustrations_2025-2026/Happiness.png" alt="Happiness">
                    <div class="img-card-overlay">
                        <span class="img-card-title">Happiness</span>
                        <span class="img-card-year">2025–2026</span>
                    </div>
                </div>
            </div>

        </div><!-- /.gallery -->
    </div><!-- /.project-page -->

    <!-- ── Lightbox ── -->
    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
        <button class="lightbox-close" id="lbClose" aria-label="Close">&#215;</button>
        <button class="lightbox-nav lightbox-prev" id="lbPrev" aria-label="Previous">&#8592;</button>
        <button class="lightbox-nav lightbox-next" id="lbNext" aria-label="Next">&#8594;</button>
        <div class="lightbox-inner">
            <div class="lightbox-frame">
                <img id="lbImg" src="" alt="">
            </div>
            <div class="lightbox-caption">
                <span class="lightbox-title" id="lbTitle"></span>
                <span class="lightbox-sub">Blender · 2025–2026</span>
            </div>
        </div>
    </div>

    <script>
        // Ordered for lightbox navigation — matches visual reading order
        const pieces = [
            { src: '/img/Illustrations_2025-2026/Love.png',      name: 'Love'      },
            { src: '/img/Illustrations_2025-2026/Buddha.png',    name: 'Buddha'    },
            { src: '/img/Illustrations_2025-2026/Deutro.png',    name: 'Deutro'    },
            { src: '/img/Illustrations_2025-2026/Happiness.png', name: 'Happiness' },
            { src: '/img/Illustrations_2025-2026/Gold.png',      name: 'Gold'      },
            { src: '/img/Illustrations_2025-2026/Angel.png',     name: 'Angel'     },
        ];

        const lb      = document.getElementById('lightbox');
        const lbImg   = document.getElementById('lbImg');
        const lbTitle = document.getElementById('lbTitle');
        let current   = 0;

        function openLightbox(index) {
            current = ((index % pieces.length) + pieces.length) % pieces.length;
            lbImg.src           = pieces[current].src;
            lbImg.alt           = pieces[current].name;
            lbTitle.textContent = pieces[current].name;
            lb.classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            lb.classList.remove('open');
            document.body.style.overflow = '';
        }

        function navigate(dir) { openLightbox(current + dir); }

        // Attach click to every card
        document.querySelectorAll('.img-card').forEach(card => {
            card.addEventListener('click', () => openLightbox(+card.dataset.index));
        });

        document.getElementById('lbClose').addEventListener('click', closeLightbox);
        document.getElementById('lbPrev').addEventListener('click', () => navigate(-1));
        document.getElementById('lbNext').addEventListener('click', () => navigate(1));

        lb.addEventListener('click', e => { if (e.target === lb) closeLightbox(); });

        document.addEventListener('keydown', e => {
            if (!lb.classList.contains('open')) return;
            if (e.key === 'Escape')     closeLightbox();
            if (e.key === 'ArrowLeft')  navigate(-1);
            if (e.key === 'ArrowRight') navigate(1);
        });

        // Touch swipe in lightbox
        let touchStartX = 0;
        lb.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
        lb.addEventListener('touchend',   e => {
            const dx = e.changedTouches[0].clientX - touchStartX;
            if (Math.abs(dx) > 48) navigate(dx < 0 ? 1 : -1);
        }, { passive: true });
    </script>

</body>
</html>
