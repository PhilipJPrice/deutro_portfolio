<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chess Animation — Deutro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/videos.css">
</head>
<body>
    <%- include('../partials/topbar') %>

    <div class="project-page">

        <!-- Breadcrumb -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="breadcrumb-sep">›</span>
            <a href="/#animations">Animations</a>
            <span class="breadcrumb-sep">›</span>
            <span>Chess Animation</span>
        </nav>

        <!-- Header -->
        <header class="project-header">
            <p class="project-eyebrow">Animation · 2025</p>
            <h1 class="project-title">Chess Set</h1>
            <p class="project-desc">
                A cinematic 3D render of a fully set Staunton-inspired chess board, built 
                entirely in Blender. The camera slowly orbits the board in a continuous arc. 
                The board sits on a warm wooden frame with a dark walnut grain, its squares 
                rendered in crisp black and white, catching soft diffused light from above. 
                Underneath the visuals, chess-inspired piano music sets a contemplative tone 
                — measured, elegant, and unhurried, like the game itself.
            </p>
            <div class="project-meta">
                <span class="sw-badge badge-blender">Blender</span>
                <span class="sw-badge badge-capcut">CapCut</span>
            </div>
        </header>

        <div class="gold-rule"></div>

        <!-- Video -->
        <section class="video-section" aria-label="Staunton Chess Set Video">
            <div class="video-glow"></div>
            <div class="video-frame">
                <div class="video-inner">
                    <video
                        controls
                        preload="metadata"
                        poster="/img/Video_Covers/Chess_Cover.png"
                        aria-label="Staunton Chess Set animation video"
                    >
                        <source src="/mp4/Chess.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
            </div>
        </section>

    </div>
</body>
</html>
