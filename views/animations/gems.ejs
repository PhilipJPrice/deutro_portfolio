<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gems Animation — Deutro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/videos.css">
</head>
<body>
    <%- include('../partials/topbar') %>

    <div class="project-page">

        <!-- Breadcrumb -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="breadcrumb-sep">›</span>
            <a href="/#animations">Animations</a>
            <span class="breadcrumb-sep">›</span>
            <span>Gem Animations</span>
        </nav>

        <!-- Header -->
        <header class="project-header">
            <p class="project-eyebrow">Animation · 2025</p>
            <h1 class="project-title">Gems</h1>
            <p class="project-desc">
                Glowing animations featuring gems and a gold coin. 
            </p>
            <div class="project-meta">
                <span class="sw-badge badge-blender">Blender</span>
                <span class="sw-badge badge-capcut">CapCut</span>
            </div>
        </header>

        <div class="gold-rule"></div>

        <!-- Videos -->
        <section class="video-section video-margin" aria-label="Diamond Animation Video">
            <div class="video-glow"></div>
            <div class="video-frame">
                <div class="video-inner">
                    <video
                        controls
                        preload="metadata"
                        poster="/img/Video_Covers/Diamond_Cover.png"
                        aria-label="Diamond animation video"
                    >
                        <source src="/mp4/Diamond.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
            </div>
        </section>

