# Dependency directories (never commit these)
node_modules/
jspm_packages/
web_modules/

# Environment variables and secrets (contains API keys, DB credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented code coverage (e.g., Jest/NYC)
coverage/
.nyc_output/

# Optional build outputs (uncomment if using TypeScript or bundlers)
# dist/
# build/

# Optional IDE specific files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
Thumbs.db
